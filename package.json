{
  "name": "@ahmednawaz/crank",
  "version": "0.2.8",
  "description": "Internal Motive UX copy iteration: select UI text \u2192 Glean variants \u2192 MCP apply. Cursor, Replit, Claude.",
  "repository": {
    "type": "git",
    "url": "https://github.com/ahmednawaz619/crank.git"
  },
  "homepage": "https://github.com/ahmednawaz619/crank#readme",
  "bin": {
    "crank": "bin/crank.js"
  },
  "main": "./react.js",
  "module": "./react.mjs",
  "types": "./react.d.ts",
  "exports": {
    ".": {
      "types": "./react.d.ts",
      "import": "./react.mjs",
      "require": "./react.js",
      "default": "./react.mjs"
    },
    "./react": {
      "types": "./react.d.ts",
      "import": "./react.mjs",
      "require": "./react.js",
      "default": "./react.mjs"
    },
    "./next": {
      "import": "./next.mjs",
      "require": "./next.js",
      "default": "./next.mjs"
    },
    "./vite": "./vite.js",
    "./webpack": "./webpack.js",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "html-webpack-plugin": ">=5",
    "next": ">=13",
    "react": ">=17"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "html-webpack-plugin": {
      "optional": true
    }
  },
  "workspaces": [
    "companion",
    "mcp-server"
  ],
  "scripts": {
    "start": "node bin/crank.js",
    "crank": "node bin/crank.js",
    "companion": "npm run start --workspace=companion",
    "mcp": "npm run start --workspace=mcp-server",
    "mcp:http": "npm run start:http --workspace=mcp-server",
    "demo": "node scripts/demo-flow.js",
    "test:parse": "node scripts/test-parse-options.js",
    "test:resolve": "node scripts/test-resolve-project.js",
    "prepare:publish": "node scripts/prepare-publish.js",
    "verify:deps": "node scripts/verify-deps.js",
    "publish:team": "node scripts/prepare-publish.js && node scripts/verify-deps.js && npm publish --access public",
    "test:patch-vite": "node scripts/test-patch-vite.js",
    "test:react-detect": "node scripts/test-react-detect.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@babel/parser": "^7.28.0",
    "@babel/traverse": "^7.28.0",
    "@cursor/sdk": "^1.0.23",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "ws": "^8.18.0",
    "zod": "^3.24.2"
  },
  "files": [
    "bin",
    "lib",
    "companion",
    "mcp-server",
    "bookmarklet",
    "skills",
    "skill",
    "panel",
    "vite.js",
    "react.js",
    "react.mjs",
    "react.d.ts",
    "next.js",
    "next.mjs",
    "webpack.js",
    ".env.example",
    "CLAUDE.md",
    "AGENTS.md",
    "REPLIT.md",
    "team.env",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "crank",
    "glean",
    "mcp",
    "copy",
    "ux-writing",
    "react"
  ],
  "devDependencies": {
    "@ahmednawaz/crank": "^0.2.4"
  }
}
