# Companion (browser ↔ local bridge)
VIZCOPY_PORT=3344
VIZCOPY_HOST=127.0.0.1

# Glean agent API (replace with real Motive Glean endpoint when available)
GLEAN_API_URL=https://glean.example.internal/v1/copy/variants
GLEAN_API_KEY=
GLEAN_AGENT_ID=
# When true (default), skip network and return deterministic stub variants
GLEAN_STUB=true

# MCP server
VIZCOPY_MCP_MODE=stdio
# For Replit / remote agents, run HTTP mode and expose HTTPS:
# VIZCOPY_MCP_MODE=http
# VIZCOPY_MCP_HTTP_PORT=3345
# Optional shared secret for remote MCP clients (Replit custom headers)
VIZCOPY_MCP_API_KEY=

# Companion URL the MCP server uses to talk to the selection store
VIZCOPY_COMPANION_URL=http://127.0.0.1:3344
